<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>DV_CargoShuttle</defName>
    <label>freight shuttle</label>
    <description>A large, chemfuel-powered cargo transport shuttle designed for hauling resources. It is capable of reaching orbital locations. Less fuel efficient than a passenger shuttle, but can carry far more.\n\n&lt;color=#02b2e9ff&gt;Gameplay use:&lt;/color&gt; The increased fuel use makes the freight shuttle a bad choice for light transport, but for large resource hauls it's the far better choice.</description>
    <thingClass>Building_PassengerShuttle</thingClass>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <size>(3,5)</size>
    <drawHighlight>true</drawHighlight>
    <highlightColor>(0.56, 0.62, 0.9)</highlightColor>
    <uiIconScale>1</uiIconScale>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/DV_CargoShuttle/DV_CargoShuttle</texPath>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3.5,5.5)</drawSize>
      <shadowData>
        <volume>(1.8, 1.0, 4.1)</volume>
        <offset>(-0.1, 0, 0)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>36000</WorkToBuild>
      <Mass>125</Mass>
      <Comfort>0.40</Comfort>
    </statBases>
    <tickerType>Normal</tickerType>
    <designationCategory>Odyssey</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <costList>
      <Steel>350</Steel>
      <Plasteel>10</Plasteel>
      <ComponentIndustrial>10</ComponentIndustrial>
      <ShuttleEngine>2</ShuttleEngine>
    </costList>
    <canOverlapZones>true</canOverlapZones>
    <killedLeavings>
      <Steel>50</Steel>
      <Plasteel>50</Plasteel>
      <ChunkSlagSteel>4</ChunkSlagSteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </killedLeavings>
    <rotatable>true</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(2, 0, 0)</interactionCellOffset>
    <defaultPlacingRot>East</defaultPlacingRot>
    <selectable>true</selectable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <drawerType>RealtimeOnly</drawerType>
    <repairEffect>ConstructMetal</repairEffect>
    <forceDebugSpawnable>true</forceDebugSpawnable>
    <building>
      <claimable>false</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <paintable>true</paintable>
      <isInert>true</isInert>
      <forcedCostLeavings>
        <li MayRequire="Ludeon.RimWorld.Odyssey">ShuttleEngine</li>
      </forcedCostLeavings>
    </building>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>Shuttles</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Shuttle">
        <shipDef>DV_Ship_CargoShuttle</shipDef>
      </li>
      <li Class="CompProperties_Launchable">
        <fuelPerTile>7</fuelPerTile>
        <minFuelCost>50</minFuelCost>
        <skyfallerLeaving>DV_CargoShuttleLeaving</skyfallerLeaving>
        <worldObjectDef>DV_CargoShuttle</worldObjectDef>
        <cooldownTicks>3750</cooldownTicks>        <!-- 1.5 hours -->
        <fixedLaunchDistanceMax>62</fixedLaunchDistanceMax>
        <cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage>
      </li>
      <li Class="CompProperties_Transporter">
        <massCapacity>1200</massCapacity>
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound>
        <pawnExitSound>Shuttle_PawnExit</pawnExitSound>
        <showMassInInspectString>true</showMassInInspectString>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>600</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>400</initialConfigurableTargetFuelLevel>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <fuelLabel>Chemfuel</fuelLabel>
        <fuelGizmoLabel>Chemfuel</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
      <li Class="CompProperties_AmbientSound">
        <sound>ShuttleIdle_Ambience</sound>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <uiOrder>2600</uiOrder>
  </ThingDef>

  <TransportShipDef>
    <defName>DV_Ship_CargoShuttle</defName>
    <label>freight shuttle</label>
    <shipThing>DV_CargoShuttle</shipThing>
    <arrivingSkyfaller>DV_CargoShuttleIncoming</arrivingSkyfaller>
    <leavingSkyfaller>DV_CargoShuttleLeaving</leavingSkyfaller>
    <worldObject>DV_CargoShuttle</worldObject>
    <playerShuttle>true</playerShuttle>
  </TransportShipDef>

  <WorldObjectDef ParentName="ShuttleWorldObjectBase">
    <defName>DV_CargoShuttle</defName>
    <label>freight shuttle</label>
    <description>A freight shuttle in flight.</description>
    <expandingIconTexture>World/WorldObjects/Expanding/DV_FreightShuttle</expandingIconTexture>
    <expandingIconDrawSize>1</expandingIconDrawSize>
  </WorldObjectDef>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>DV_CargoShuttleIncoming</defName>
    <label>freight shuttle (incoming)</label>
    <thingClass>PassengerShuttleIncoming</thingClass>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/DV_CargoShuttle/DV_CargoShuttle</texPath>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3.5,5.5)</drawSize>
    </graphicData>
    <size>(3,5)</size>
    <skyfaller>
      <anticipationSound>Shuttle_Landing</anticipationSound>
      <anticipationSoundTicks>250</anticipationSoundTicks>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <minimalRoofDestruction>true</minimalRoofDestruction>
      <shadowSize>(3.5,5.5)</shadowSize>
      <rotationCurve>
        <points>
          <li>(0,30)</li>
          <li>(0.5,5)</li>
          <li>(0.9,-5)</li>
          <li>(0.95,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0.95,2.5)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.6,0.6)</li>
          <li>(0.95,0.1)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>DV_CargoShuttleLeaving</defName>
    <label>freight shuttle (leaving)</label>
    <thingClass>PassengerShuttleLeaving</thingClass>
    <rotatable>true</rotatable>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/DV_CargoShuttle/DV_CargoShuttle</texPath>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3.5,5.5)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <size>(3,5)</size>
    <skyfaller>
      <reversed>true</reversed>
      <anticipationSound>Shuttle_Leaving</anticipationSound>
      <anticipationSoundTicks>-10</anticipationSoundTicks>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <shadow>Things/Skyfaller/SkyfallerShadowRectangle</shadow>
      <shadowSize>(3.5,5.5)</shadowSize>
      <motesPerCell>1</motesPerCell>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.15,12)</li>
          <li>(0.5,-5)</li>
          <li>(0.8,-14)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.04,0.5)</li>
          <li>(0.08,1.4)</li>
          <li>(0.12,2.2)</li>
          <li>(0.14,2.6)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0,0.1)</li>
          <li>(0.4,0.2)</li>
          <li>(0.8,0.4)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>


  <ThingDef ParentName="BuildingBase">
    <defName>DV_GravPodCar</defName>
    <label>grav podcar</label>
    <description>A luxurious, two-seater passenger vehicle powered by a gravcore. The gravlift system allows the vehicle to be incredibly fuel-efficient, negating the effects of gravity and allowing for a smooth, calm ride. It still utilizes chemfuel for forward thrust, but much less than normal shuttles do. Podcars like these are commonplace on particularly inhabited glitterworlds.\n\nNotably, some models are shipped with low-level AI cores for self-driving capabilities and companionship on long trips.\n\n&lt;color=#02b2e9ff&gt;Gameplay use:&lt;/color&gt; While vastly lacking in trunk space and seating, the grav podcar is the most efficient method of reusable transport, traveling at 1 tile per fuel, it also has the shortest cooldown. A good choice for quests.</description>
    <thingClass>Building_PassengerShuttle</thingClass>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <size>(2,3)</size>
    <drawHighlight>true</drawHighlight>
    <highlightColor>(0.56, 0.62, 0.9)</highlightColor>
    <uiIconScale>1</uiIconScale>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSpecial</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticBuilding</li>
    </tradeTags>
    <thingSetMakerTags>
      <li>RewardStandardCore</li>
    </thingSetMakerTags>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/DV_GravPodCar/DV_GravPodCar</texPath>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2.3,3.22)</drawSize>
      <shadowData>
        <volume>(1.4, 1.0, 2.5)</volume>
        <offset>(-0.1, 0, 0)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>36000</WorkToBuild>
      <Mass>200</Mass>
      <Comfort>0.90</Comfort>
    </statBases>
    <tickerType>Normal</tickerType>
    <costList>
      <Steel>250</Steel>
      <Plasteel>150</Plasteel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <Gravcore>1</Gravcore>
    </costList>
    <canOverlapZones>true</canOverlapZones>
    <killedLeavings>
      <Steel>50</Steel>
      <Plasteel>50</Plasteel>
      <ChunkSlagSteel>4</ChunkSlagSteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </killedLeavings>
    <rotatable>true</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(2, 0, 0)</interactionCellOffset>
    <defaultPlacingRot>East</defaultPlacingRot>
    <selectable>true</selectable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <drawerType>RealtimeOnly</drawerType>
    <repairEffect>ConstructMetal</repairEffect>
    <forceDebugSpawnable>true</forceDebugSpawnable>
    <building>
      <claimable>false</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <paintable>true</paintable>
      <isInert>true</isInert>
      <neverBuildable>true</neverBuildable>
      <forcedCostLeavings>
        <li MayRequire="Ludeon.RimWorld.Odyssey">Gravcore</li>
      </forcedCostLeavings>
    </building>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Shuttle">
        <shipDef>DV_Ship_GravCar</shipDef>
      </li>
      <li Class="CompProperties_Launchable">
        <fuelPerTile>1</fuelPerTile>
        <minFuelCost>1</minFuelCost>
        <skyfallerLeaving>DV_GravCarLeaving</skyfallerLeaving>
        <worldObjectDef>DV_GravCar</worldObjectDef>
        <cooldownTicks>1500</cooldownTicks>
        <fixedLaunchDistanceMax>50</fixedLaunchDistanceMax>
        <cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage>
      </li>
      <li Class="CompProperties_Transporter">
        <massCapacity>200</massCapacity>
        <restEffectiveness>1</restEffectiveness>
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound>
        <pawnExitSound>Shuttle_PawnExit</pawnExitSound>
        <showMassInInspectString>true</showMassInInspectString>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>150</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>75</initialConfigurableTargetFuelLevel>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <fuelLabel>Chemfuel</fuelLabel>
        <fuelGizmoLabel>Chemfuel</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
      <li Class="CompProperties_DrawAdditionalGraphics">
        <graphics>
          <li>
            <graphicClass>Graphic_Multi</graphicClass>
            <texPath>Things/Building/DV_GravGlow/DV_GravGlow</texPath>
            <drawSize>(2.3,3.22)</drawSize>
            <shaderType>MoteGlow</shaderType>
          </li>
        </graphics>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <uiOrder>2600</uiOrder>
  </ThingDef>

  <TransportShipDef>
    <defName>DV_Ship_GravCar</defName>
    <label>grav podcar</label>
    <shipThing>DV_GravPodCar</shipThing>
    <arrivingSkyfaller>DV_GravCarIncoming</arrivingSkyfaller>
    <leavingSkyfaller>DV_GravCarLeaving</leavingSkyfaller>
    <worldObject>DV_GravCar</worldObject>
    <playerShuttle>true</playerShuttle>
  </TransportShipDef>

  <WorldObjectDef ParentName="ShuttleWorldObjectBase">
